# Template only. Copy to .env.production (gitignored), chmod 600, then fill locally.
# Jeff must approve the host/domain/cost and configure Google. Never paste secrets into chat.
STORYBOARD_WEB_HOST=band.example.com
STORYBOARD_API_HOST=band-api.example.com
WEB_URL=https://band.example.com
API_URL=https://band-api.example.com
NEXT_PUBLIC_API_URL=https://band-api.example.com
# A shared parent domain lets server-rendered web requests receive the API session.
# Both hostnames must be trusted subdomains of this parent.
COOKIE_DOMAIN=example.com
POSTGRES_USER=storyboard
POSTGRES_DB=storyboard
POSTGRES_PASSWORD=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OPERATOR_REDIRECT_URI=https://band-api.example.com/auth/operator/google/callback
# Optional; leave disconnected during the first access/data pilot.
GOOGLE_REDIRECT_URI=
INTEGRATION_SECRETS_ENCRYPTION_KEY=
